    expect(() => toMinorUnits('', 'EUR')).toThrow()
    expect(() => toMinorUnits('12.345.67', 'EUR')).toThrow()
  })

  it('converte centavos de volta para decimal', () => {
    expect(fromMinorUnits(123456, 'EUR')).toBe('1234.56')

          </BrowserRouter>
        </HouseholdProvider>
      </AuthProvider>
    </I18nProvider>
  </StrictMode>,
)

if (import.meta.env.PROD && 'serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch((error: unknown) => {
      console.warn('Falha ao registrar o service worker:', error)
    })
  })
}

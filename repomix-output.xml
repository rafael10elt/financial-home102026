<file path="src/features/finance/ImportWizard.tsx">
import { useMemo, useState } from 'react'
import { useI18n } from '../../i18n'
import { useAuth } from '../../auth/context'
import {
  DEFAULT_DIALECT,
  detectDuplicates,
  guessMapping,
  mapRows,
  parseCsv,
  sniffSeparator,
  type ColumnMapping,
  type CsvDialect,
  type ParsedRow,
} from '../../finance/csv'
import { extractPdfText, parsePdfLines } from '../../finance/pdf'
import { toMinorUnits } from '../../finance/money'
import { Button } from '../../ui/Button'
import { Card, CardDescription, CardTitle } from '../../ui/Card'
import { Field, Input } from '../../ui/Input'
import { inputClass } from './financeForm'
import type { Account, Transaction } from '../../finance/useFinance'

type ReviewRow = {
  key: number
  date: string
  description: string
  amountMinor: number
  amountText: string
  currency: string
  categoryId: string
  kind: 'income' | 'expense'
  selected: boolean
  duplicateOf: string | null
}

export function ImportWizard({
  accounts,
  existing,
  busy,
  error,
  onImport,
  onClose,
}: {
  accounts: Account[]
  existing: Transaction[]
  busy: boolean
  error: string | null
  onImport: (input: {
    filename: string
    source: 'csv' | 'pdf'
    accountId: string
    rows: ReviewRow[]
  }) => Promise<void>
  onClose: () => void
}) {
  const { t } = useI18n()
  const { supabase } = useAuth()

  const [step, setStep] = useState<'file' | 'preview'>('file')
  const [filename, setFilename] = useState('')
  const [source, setSource] = useState<'csv' | 'pdf'>('csv')
  const [fileError, setFileError] = useState<string | null>(null)
  const [reading, setReading] = useState(false)
  const [dialect, setDialect] = useState<CsvDialect>(DEFAULT_DIALECT)
  const [mapping, setMapping] = useState<ColumnMapping>({
    date: null,
    description: null,
    amount: null,
    currency: null,
    category: null,
  })
  const [header, setHeader] = useState<string[]>([])
  const [body, setBody] = useState<string[][]>([])
  const [accountId, setAccountId] = useState(accounts[0]?.id ?? '')
  const [defaultKind, setDefaultKind] = useState<'income' | 'expense'>('expense')
  const [defaultCurrency, setDefaultCurrency] = useState(accounts[0]?.currency ?? 'EUR')
  const [rows, setRows] = useState<ReviewRow[]>([])

  const duplicateIndex = useMemo(() => {
    const parsed: { date: string; amountMinor: number; description: string }[] = rows.map((row) => ({
      date: row.date,
      amountMinor: row.amountMinor,
      description: row.description,
    }))
    const asParsed: Parameters<typeof detectDuplicates>[0] = parsed.map((row, index) => ({
      lineNo: index + 1,
      raw: [],
      date: row.date,
      description: row.description,
      amountMinor: row.amountMinor,
      amountText: String(row.amountMinor),
      currency: 'EUR',
      categoryName: null,
      errors: [],
    }))
    const hits = detectDuplicates(
      asParsed,
      existing.map((tx) => ({
        id: tx.id,
        date: tx.date,
        amountMinor: Math.abs(toMinorUnits(tx.amount, tx.currency)),
        description: tx.description,
      })),
    )
    return new Map(hits.map((hit) => [hit.rowIndex, hit.existingId]))
  }, [rows, existing])

  async function handleFile(file: File) {
    setFileError(null)
    if (file.size > 10 * 1024 * 1024) {
      setFileError('Arquivo maior que 10 MB.')
      return
    }
    const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')
    const isCsv = file.name.toLowerCase().endsWith('.csv') || file.type.startsWith('text/')
    if (!isPdf && !isCsv) {
      setFileError(t('fin.importFile'))
      return
    }

    setReading(true)
    try {
      if (isPdf) {
        setSource('pdf')
        setFilename(file.name)
        const result = await extractPdfText(file)
        if ('error' in result) {
          setFileError(result.error)
          return
        }
        const candidates = parsePdfLines(result.text)
        if (candidates.length === 0) {
          setFileError(t('fin.importNoRows'))
          return
        }
        setHeader([])
        setBody([])
        setRows(
          candidates.map((candidate, index) => ({
            key: index,
            date: candidate.date ?? '',
            description: candidate.description,
            amountMinor: Math.abs(candidate.amountMinor ?? 0),
            amountText: candidate.amountText ?? '',
            currency: defaultCurrency,
            categoryId: '',
            kind: (candidate.amountMinor ?? 0) < 0 ? 'income' : 'expense',
            selected: candidate.date !== null && candidate.amountMinor !== null,
            duplicateOf: null,
          })),
        )
        setStep('preview')
      } else {
        setSource('csv')
        setFilename(file.name)
        const text = await file.text()
        const firstLine = text.split(/\r?\n/, 1)[0] ?? ''
        const separator = sniffSeparator(firstLine)
        const parsed = parseCsv(text, separator)
        if (parsed.length < 2) {
          setFileError(t('fin.importNoRows'))
          return
        }
        const [head, ...rest] = parsed as [string[], ...string[][]]
        setHeader(head)
        setBody(rest)
        setDialect({ ...DEFAULT_DIALECT, separator })
        setMapping(guessMapping(head))
      }
    } finally {
      setReading(false)
    }
  }

  function buildPreview() {
    const mapped = mapRows(body, mapping, dialect, defaultCurrency)
    const valid: ParsedRow[] = mapped.filter(
      (row) => row.date && row.amountMinor !== null && row.description && row.errors.length === 0,
    )
    if (valid.length === 0) {
      setFileError(t('fin.importNoRows'))
      return
    }
    setRows(
      valid.map((row, index) => ({
        key: index,
        date: row.date as string,
        description: row.description as string,
        amountMinor: Math.abs(row.amountMinor as number),
        amountText: row.amountText ?? '',
        currency: row.currency ?? defaultCurrency,
        categoryId: '',
        kind: (row.amountMinor as number) < 0 ? 'income' : 'expense',
        selected: true,
        duplicateOf: null,
      })),
    )
    setStep('preview')
  }

  function toggleRow(key: number) {
    setRows((current) =>
      current.map((row) => (row.key === key ? { ...row, selected: !row.selected } : row)),
    )
  }

  function updateRow(key: number, patch: Partial<ReviewRow>) {
    setRows((current) => current.map((row) => (row.key === key ? { ...row, ...patch } : row)))
  }

  const selectedCount = rows.filter((row) => row.selected).length

  if (step === 'file' || (step === 'preview' && source === 'csv' && rows.length === 0)) {
    return (
      <div className="flex flex-col gap-4">
        <p className="text-xs text-muted-foreground">{t('fin.csvHint')}</p>
        <p className="text-xs text-muted-foreground">{t('fin.pdfHint')}</p>

        <Field label={t('fin.importFile')}>
          {(aria) => (
            <Input
              {...aria}
              type="file"
              accept=".csv,.pdf,text/csv,application/pdf"
              onChange={(e) => {
                const file = e.target.files?.[0]
                if (file) void handleFile(file)
              }}
            />
          )}
        </Field>

        {reading && (
          <p className="text-sm text-muted-foreground" role="status">
            {t('common.loading')}
          </p>
        )}
        {fileError && (
          <p role="alert" className="text-sm text-destructive">
            {fileError}
          </p>
        )}

        {body.length > 0 && (
          <Card>
            <CardTitle className="mb-2">{t('fin.importPreview')}</CardTitle>
            <div className="mb-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
              <Field label="Separador">
                {(aria) => (
                  <select
                    {...aria}
                    value={dialect.separator}
                    onChange={(e) =>
                      setDialect({ ...dialect, separator: e.target.value as CsvDialect['separator'] })
                    }
                    className={inputClass}
                  >
                    <option value=";">;</option>
                    <option value=",">,</option>
                    <option value="	">Tab</option>
                    <option value="|">|</option>
                  </select>
                )}
              </Field>
              <Field label="Formato de data">
                {(aria) => (
                  <select
                    {...aria}
                    value={dialect.dateFormat}
                    onChange={(e) =>
                      setDialect({ ...dialect, dateFormat: e.target.value as CsvDialect['dateFormat'] })
                    }
                    className={inputClass}
                  >
                    <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                    <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                    <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                  </select>
                )}
              </Field>
              <Field label="Decimal">
                {(aria) => (
                  <select
                    {...aria}
                    value={dialect.decimalSeparator}
                    onChange={(e) =>
                      setDialect({
                        ...dialect,
                        decimalSeparator: e.target.value as '.' | ',',
                      })
                    }
                    className={inputClass}
                  >
                    <option value=",">, (pt-BR)</option>
                    <option value=".">. (en)</option>
                  </select>
                )}
              </Field>
            </div>

            <div className="mb-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
              {(['date', 'description', 'amount', 'currency', 'category'] as const).map((field) => (
                <Field key={field} label={field}>
                  {(aria) => (
                    <select
                      {...aria}
                      value={mapping[field] ?? ''}
                      onChange={(e) =>
                        setMapping({
                          ...mapping,
                          [field]: e.target.value === '' ? null : Number(e.target.value),
                        })
                      }
                      className={inputClass}
                    >
                      <option value="">—</option>
                      {header.map((name, index) => (
                        <option key={index} value={index}>
                          {index}: {name}
                        </option>
                      ))}
                    </select>
                  )}
                </Field>
              ))}
            </div>

            <p className="mb-2 text-xs text-muted-foreground">
              {body.length} linhas · {header.join(' | ').slice(0, 120)}
            </p>
            <Button onClick={buildPreview}>{t('fin.importPreview')}</Button>
          </Card>
        )}

        <div className="flex justify-end">
          <Button variant="secondary" onClick={onClose}>
            {t('common.close')}
          </Button>
        </div>
      </div>
    )
  }

  return (
    <div className="flex flex-col gap-4">
      <Card>
        <CardTitle className="mb-1">
          {t('fin.importPreview')} · {filename}
        </CardTitle>
        <CardDescription>
          {t('fin.importOrigin')}: {filename} · {selectedCount}/{rows.length}
        </CardDescription>
      </Card>

      <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <Field label={t('fin.importAccount')}>
          {(aria) => (
            <select
              {...aria}
              value={accountId}
              onChange={(e) => {
                setAccountId(e.target.value)
                const account = accounts.find((a) => a.id === e.target.value)
                if (account) setDefaultCurrency(account.currency)
              }}
              className={inputClass}
            >
              {accounts.map((account) => (
                <option key={account.id} value={account.id}>
                  {account.name} ({account.currency})
                </option>
              ))}
            </select>
          )}
        </Field>
        <Field label={t('fin.importKind')}>
          {(aria) => (
            <select
              {...aria}
              value={defaultKind}
              onChange={(e) => setDefaultKind(e.target.value as 'income' | 'expense')}
              className={inputClass}
            >
              <option value="expense">{t('fin.expense')}</option>
              <option value="income">{t('fin.income')}</option>
            </select>
          )}
        </Field>
        <Field label={t('fin.currency')}>
          {(aria) => (
            <select
              {...aria}
              value={defaultCurrency}
              onChange={(e) => setDefaultCurrency(e.target.value)}
              className={inputClass}
            >
              <option value="EUR">EUR</option>
              <option value="BRL">BRL</option>
            </select>
          )}
        </Field>
      </div>

      {source === 'pdf' && (
        <p className="text-xs text-muted-foreground">{t('fin.pdfOcrNote')}</p>
      )}

      <ul className="flex flex-col gap-2">
        {rows.map((row, index) => {
          const duplicateOf = duplicateIndex.get(index) ?? null
          return (
            <li
              key={row.key}
              className={
                duplicateOf
                  ? 'flex flex-col gap-2 rounded-md border border-destructive/50 bg-destructive/5 p-3'
                  : 'flex flex-col gap-2 rounded-md border border-border p-3'
              }
            >
              <div className="flex items-start gap-2">
                <input
                  type="checkbox"
                  checked={row.selected}
                  onChange={() => toggleRow(row.key)}
                  aria-label={`${t('fin.importAccept')}: ${row.description}`}
                  className="mt-1"
                />
                <div className="grid flex-1 grid-cols-2 gap-2 sm:grid-cols-5">
                  <Input
                    type="date"
                    aria-label={t('fin.date')}
                    value={row.date}
                    onChange={(e) => updateRow(row.key, { date: e.target.value })}
                  />
                  <Input
                    aria-label={t('fin.description')}
                    value={row.description}
                    maxLength={200}
                    onChange={(e) => updateRow(row.key, { description: e.target.value })}
                    className="col-span-2"
                  />
                  <Input
                    aria-label={t('fin.amount')}
                    value={(row.amountMinor / 100).toFixed(2)}
                    inputMode="decimal"
                    onChange={(e) => {
                      const parsed = Number(e.target.value.replace(',', '.'))
                      if (Number.isFinite(parsed) && parsed >= 0) {
                        updateRow(row.key, { amountMinor: Math.round(parsed * 100) })
                      }
                    }}
                  />
                  <select
                    aria-label={t('fin.kind')}
                    value={row.kind}
                    onChange={(e) => updateRow(row.key, { kind: e.target.value as 'income' | 'expense' })}
                    className={inputClass}
                  >
                    <option value="expense">{t('fin.expense')}</option>
                    <option value="income">{t('fin.income')}</option>
                  </select>
                </div>
              </div>
              {duplicateOf && (
                <p className="text-xs text-destructive">
                  {t('fin.importDuplicate')} · {duplicateOf.slice(0, 8)}
                </p>
              )}
            </li>
          )
        })}
      </ul>

      {rows.length === 0 && (
        <p className="text-sm text-muted-foreground">{t('fin.importNoRows')}</p>
      )}

      {error && (
        <p role="alert" className="text-sm text-destructive">
          {error}
        </p>
      )}

      {supabase === null && (
        <p className="text-xs text-muted-foreground">{t('env.supabaseMissing')}</p>
      )}

      <div className="flex justify-end gap-2">
        <Button
          variant="secondary"
          onClick={() => {
            setStep('file')
            setRows([])
            setBody([])
          }}
        >
          {t('common.retry')}
        </Button>
        <Button
          disabled={busy || selectedCount === 0 || !accountId}
          onClick={() =>
            void onImport({
              filename,
              source,
              accountId,
              rows: rows
                .filter((row) => row.selected)
                .map((row) => ({ ...row, currency: defaultCurrency })),
            })
          }
        >
          {busy ? t('common.loading') : `${t('fin.importConfirm')} (${selectedCount})`}
        </Button>
      </div>
    </div>
  )
}
</file>

<file path="src/features/household/OnboardingPage.tsx">
import { useState, type FormEvent } from 'react'
import { useI18n } from '../../i18n'
import { useHousehold } from '../../household/context'
import { Button } from '../../ui/Button'
import { Field, Input } from '../../ui/Input'
import { Card, CardDescription, CardTitle } from '../../ui/Card'

export function OnboardingPage() {
  const { t } = useI18n()
  const { createHousehold, joinHousehold } = useHousehold()
  const [name, setName] = useState('')
  const [code, setCode] = useState('')
  const [error, setError] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)

  async function handleCreate(event: FormEvent) {
    event.preventDefault()
    setError(null)
    if (!name.trim()) {
      setError(t('common.required'))
      return
    }
    setBusy(true)
    try {
      const result = await createHousehold(name)
      if (result.error) setError(result.error)
    } finally {
      setBusy(false)
    }
  }

  async function handleJoin(event: FormEvent) {
    event.preventDefault()
    setError(null)
    if (!code.trim()) {
      setError(t('common.required'))
      return
    }
    setBusy(true)
    try {
      const result = await joinHousehold(code)
      if (result.error) setError(result.error)
    } finally {
      setBusy(false)
    }
  }

  return (
    <div className="mx-auto flex max-w-3xl flex-col gap-6">
      <div className="flex flex-col gap-1">
        <h1 className="text-xl font-semibold">{t('house.title')}</h1>
        <p className="text-sm text-muted-foreground">{t('house.waiting')}</p>
      </div>

      {error && (
        <p role="alert" className="text-sm text-destructive">
          {error}
        </p>
      )}

      <div className="grid gap-4 md:grid-cols-2">
        <Card>
          <CardTitle className="mb-1">{t('house.create')}</CardTitle>
          <CardDescription className="mb-4">{t('house.createHint')}</CardDescription>
          <form onSubmit={handleCreate} className="flex flex-col gap-4">
            <Field label={t('house.name')}>
              {(aria) => (
                <Input
                  {...aria}
                  value={name}
                  onChange={(event) => setName(event.target.value)}
                  maxLength={80}
                />
              )}
            </Field>
            <Button type="submit" disabled={busy}>
              {t('house.create')}
            </Button>
          </form>
        </Card>

        <Card>
          <CardTitle className="mb-1">{t('house.join')}</CardTitle>
          <CardDescription className="mb-4">{t('house.joinHint')}</CardDescription>
          <form onSubmit={handleJoin} className="flex flex-col gap-4">
            <Field label={t('house.code')}>
              {(aria) => (
                <Input
                  {...aria}
                  value={code}
                  onChange={(event) => setCode(event.target.value.toUpperCase())}
                  maxLength={12}
                  autoComplete="off"
                  spellCheck={false}
                />
              )}
            </Field>
            <Button type="submit" variant="secondary" disabled={busy}>
              {t('house.join')}
            </Button>
          </form>
        </Card>
      </div>
    </div>
  )
}
</file>

<file path="src/features/notifications/NotificationsPage.tsx">
import { useEffect, useState } from 'react'
import { useI18n } from '../../i18n'
import { useAuth } from '../../auth/context'
import { useAgendaData } from '../../agenda/useAgenda'
import { loadPreferences, syncPreferences } from '../../preferences/sync'
import { Button } from '../../ui/Button'
import { Card, CardDescription, CardTitle } from '../../ui/Card'
import { Field, Input } from '../../ui/Input'

const LAST_RUN_KEY = 'fh.notif.lastrun'

function shouldRun(lastRun: string | null, now: number): boolean {
  if (!lastRun) return true
  const parsed = Date.parse(lastRun)
  if (Number.isNaN(parsed)) return true
  return now - parsed > 6 * 60 * 60 * 1000
}

export function NotificationsPage() {
  const { t } = useI18n()
  const { supabase, user } = useAuth()
  const agenda = useAgendaData()

  const [leadHours, setLeadHours] = useState(24)
  const [enabled, setEnabled] = useState(true)
  const [digest, setDigest] = useState(false)
  const [prefsLoaded, setPrefsLoaded] = useState(false)
  const [generateError, setGenerateError] = useState<string | null>(null)
  const [generating, setGenerating] = useState(false)

  // Carrega preferências de aviso.
  useEffect(() => {
    if (!supabase || !user || prefsLoaded) return
    let cancelled = false
    void loadPreferences(supabase, user.id).then((result) => {
      if (cancelled || result.error || !result.state) {
        if (!cancelled) setPrefsLoaded(true)
        return
      }
      const prefs = result.state as {
        notifEnabled?: boolean
        notifLeadHours?: number
        notifDigest?: boolean
      }
      if (typeof prefs.notifEnabled === 'boolean') setEnabled(prefs.notifEnabled)
      if (typeof prefs.notifLeadHours === 'number') setLeadHours(prefs.notifLeadHours)
      if (typeof prefs.notifDigest === 'boolean') setDigest(prefs.notifDigest)
      if (!cancelled) setPrefsLoaded(true)
    })
    return () => {
      cancelled = true
    }
  }, [supabase, user, prefsLoaded])

  // Gera avisos de vencimento (no máximo 1 vez a cada 6h por dispositivo).
  // Todo setState acontece em callbacks assíncronos, nunca no corpo do efeito.
  useEffect(() => {
    if (!supabase || !user || !enabled || agenda.status !== 'ready' || generating) return
    let cancelled = false
    void Promise.resolve()
      .then((): string | null => {
        try {
          return localStorage.getItem(LAST_RUN_KEY)
        } catch {
          return null
        }
      })
      .then(async (lastRun) => {
        if (cancelled || !shouldRun(lastRun, Date.now())) return
        setGenerating(true)
        try {
          const result = await agenda.generateDueNotifications(leadHours)
          if (cancelled) return
          if (result.error) {
            setGenerateError(result.error)
          } else {
            try {
              localStorage.setItem(LAST_RUN_KEY, new Date().toISOString())
            } catch {
              // Cache opcional.
            }
          }
        } finally {
          if (!cancelled) setGenerating(false)
        }
      })
    return () => {
      cancelled = true
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [supabase, user, enabled, agenda.status])

  async function savePrefs(next: { enabled: boolean; leadHours: number; digest: boolean }) {
    if (!supabase || !user) return
    const current = await loadPreferences(supabase, user.id)
    const merged = {
      ...(current.state ?? {}),
      notifEnabled: next.enabled,
      notifLeadHours: next.leadHours,
      notifDigest: next.digest,
    }
    await syncPreferences(user.id, merged as never)
  }

  const unread = agenda.notifications.filter((n) => !n.read_at)

  return (
    <div className="flex flex-col gap-4">
      <div className="flex flex-wrap items-center gap-2">
        <h1 className="text-xl font-semibold">{t('notif.title')}</h1>
        {unread.length > 0 && (
          <span className="rounded-full bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground">
            {t('notif.unread', { n: unread.length })}
          </span>
        )}
        <div className="ml-auto">
          <Button
            size="sm"
            variant="secondary"
            onClick={() => void agenda.markNotificationsRead('all')}
            disabled={unread.length === 0}
          >
            {t('notif.markAllRead')}
          </Button>
        </div>
      </div>

      {generateError && (
        <p role="alert" className="text-sm text-destructive">
          {t('notif.generateError', { message: generateError })}
        </p>
      )}

      <Card>
        {agenda.status === 'loading' && (
          <p className="text-sm text-muted-foreground" role="status">
            {t('common.loading')}
          </p>
        )}
        {agenda.status === 'ready' && agenda.notifications.length === 0 && (
          <p className="text-sm text-muted-foreground">{t('notif.empty')}</p>
        )}
        {agenda.status === 'ready' && agenda.notifications.length > 0 && (
          <ul className="flex flex-col divide-y divide-[var(--border)]">
            {agenda.notifications.map((notification) => (
              <li
                key={notification.id}
                className={notification.read_at ? 'py-2.5 opacity-70' : 'py-2.5'}
              >
                <div className="flex items-start justify-between gap-2">
                  <div className="flex flex-col gap-0.5">
                    <span className="text-sm font-medium">{notification.title}</span>
                    {notification.body && (
                      <span className="text-xs text-muted-foreground">{notification.body}</span>
                    )}
                    <span className="text-[11px] text-muted-foreground">
                      {new Intl.DateTimeFormat('pt-BR', {
                        day: '2-digit',
                        month: '2-digit',
                        hour: '2-digit',
                        minute: '2-digit',
                        hourCycle: 'h23',
                      }).format(new Date(notification.created_at))}
                    </span>
                  </div>
                  {!notification.read_at && (
                    <Button
                      size="sm"
                      variant="ghost"
                      onClick={() => void agenda.markNotificationsRead([notification.id])}
                    >
                      {t('notif.markRead')}
                    </Button>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card>
        <CardTitle className="mb-1">{t('notif.settings')}</CardTitle>
        <CardDescription className="mb-3">{t('notif.pushUnsupported')}</CardDescription>
        <div className="flex flex-col gap-3">
          <label className="flex items-center gap-2 text-sm">
            <input
              type="checkbox"
              checked={enabled}
              onChange={(e) => {
                setEnabled(e.target.checked)
                void savePrefs({ enabled: e.target.checked, leadHours, digest })
              }}
            />
            {t('notif.enabled')}
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input
              type="checkbox"
              checked={digest}
              onChange={(e) => {
                setDigest(e.target.checked)
                void savePrefs({ enabled, leadHours, digest: e.target.checked })
              }}
            />
            {t('notif.digest')}
          </label>
          <Field label={t('notif.leadTime')}>
            {(aria) => (
              <Input
                {...aria}
                type="number"
                min={0}
                max={168}
                value={leadHours}
                onChange={(e) => {
                  const value = Math.max(0, Number.parseInt(e.target.value, 10) || 0)
                  setLeadHours(value)
                  void savePrefs({ enabled, leadHours: value, digest })
                }}
                className="w-28"
              />
            )}
          </Field>
        </div>
      </Card>
    </div>
  )
}
</file>

<file path="src/features/settings/GroqKeySection.tsx">
import { useState } from 'react'
import { useI18n } from '../../i18n'
import { useAuth } from '../../auth/context'
import { useHousehold } from '../../household/context'
import { env } from '../../config/env'
import { Button } from '../../ui/Button'
import { Card, CardDescription, CardTitle } from '../../ui/Card'
import { Field, Input } from '../../ui/Input'

type KeyState =
  | { checked: false }
  | { checked: true; configured: boolean; key_last4: string | null; model: string }

async function callConfig(
  supabase: { auth: { getSession: () => Promise<{ data: { session: { access_token: string } | null } }> } },
  body: unknown,
): Promise<{ data: Record<string, unknown> | null; status: number }> {
  const base = `${env.supabaseUrl.replace(/\/$/, '')}/functions/v1`
  const { data } = await supabase.auth.getSession()
  const token = data.session?.access_token ?? ''
  const response = await fetch(`${base}/groq-config`, {
    method: 'POST',
    headers: { 'content-type': 'application/json', Authorization: `Bearer ${token}` },
    body: JSON.stringify(body),
  })
  try {
    const parsed = (await response.json()) as Record<string, unknown>
    return { data: parsed, status: response.status }
  } catch {
    return { data: null, status: response.status }
  }
}

export function GroqKeySection({ onChanged }: { onChanged: () => void }) {
  const { t } = useI18n()
  const { supabase, user } = useAuth()
  const { state: householdState } = useHousehold()

  const householdId = householdState.kind === 'ready' ? householdState.household.id : null
  const isOwner =
    householdState.kind === 'ready' && householdState.household.created_by === user?.id

  const [state, setState] = useState<KeyState>({ checked: false })
  const [key, setKey] = useState('')
  const [model, setModel] = useState('llama-3.3-70b-versatile')
  const [busy, setBusy] = useState(false)
  const [message, setMessage] = useState<string | null>(null)
  const [messageError, setMessageError] = useState(false)

  async function refresh() {
    if (!supabase || !householdId) return
    setBusy(true)
    try {
      const { data } = await callConfig(supabase, { action: 'status', household_id: householdId })
      setState({
        checked: true,
        configured: Boolean(data?.configured),
        key_last4: (data?.key_last4 as string | null) ?? null,
        model: (data?.model as string | undefined) ?? 'llama-3.3-70b-versatile',
      })
      if (typeof data?.model === 'string') setModel(data.model)
    } catch {
      setState({ checked: true, configured: false, key_last4: null, model: '' })
      setMessage(t('ai.backendMissing'))
      setMessageError(true)
    } finally {
      setBusy(false)
    }
  }

  // Consulta o estado ao abrir (sem expor nada sensível).
  if (!state.checked && supabase && householdId && !busy) {
    void refresh()
  }

  const configured = state.checked && state.configured

  async function save() {
    if (!supabase || !householdId) return
    setBusy(true)
    setMessage(null)
    try {
      const { data, status } = await callConfig(supabase, {
        action: 'set',
        household_id: householdId,
        key: key.trim(),
        model: model.trim() || undefined,
      })
      if (status !== 200 || !data || data.error) {
        setMessage(mapError(String(data?.error ?? 'UNKNOWN')))
        setMessageError(true)
        return
      }
      setKey('')
      setMessage(t('ai.keySaved'))
      setMessageError(false)
      await refresh()
      onChanged()
    } finally {
      setBusy(false)
    }
  }

  function mapError(code: string): string {
    switch (code) {
      case 'INVALID_KEY':
      case 'INVALID_KEY_FORMAT':
        return t('ai.error.invalid')
      case 'QUOTA_EXCEEDED':
        return t('ai.error.quota')
      case 'MODEL_NOT_SUPPORTED':
        return t('ai.error.model')
      case 'GROQ_UNAVAILABLE':
      case 'GROQ_ERROR':
        return t('ai.error.unavailable')
      case 'NOT_HOUSEHOLD_OWNER':
        return t('ai.keyOwnerOnly')
      default:
        return t('ai.error.unknown')
    }
  }

  async function test() {
    if (!supabase || !householdId) return
    setBusy(true)
    setMessage(null)
    try {
      const { data, status } = await callConfig(supabase, { action: 'test', household_id: householdId })
      if (status === 200 && data && !data.error) {
        setMessage(t('ai.keyTestOk', { model: String(data.model ?? model) }))
        setMessageError(false)
      } else {
        setMessage(mapError(String(data?.error ?? 'UNKNOWN')))
        setMessageError(true)
      }
    } finally {
      setBusy(false)
    }
  }

  async function remove() {
    if (!supabase || !householdId) return
    setBusy(true)
    try {
      await callConfig(supabase, { action: 'remove', household_id: householdId })
      setMessage(t('ai.keyMissing'))
      setMessageError(false)
      await refresh()
      onChanged()
    } finally {
      setBusy(false)
    }
  }

  return (
    <Card>
      <CardTitle className="mb-1">{t('ai.keyTitle')}</CardTitle>
      <CardDescription className="mb-3">{t('ai.keyMasked')}</CardDescription>

      {!isOwner ? (
        <p className="text-sm text-muted-foreground">{t('ai.keyOwnerOnly')}</p>
      ) : (
        <div className="flex flex-col gap-3">
          <p className="text-sm" role="status">
            {!state.checked
              ? t('common.loading')
              : state.configured
                ? t('ai.keyConfigured', { last4: state.key_last4 ?? '••••' })
                : t('ai.keyMissing')}
          </p>

          <Field label={t('ai.keyInput')}>
            {(aria) => (
              <Input
                {...aria}
                type="password"
                autoComplete="off"
                spellCheck={false}
                value={key}
                placeholder="gsk_…"
                onChange={(e) => setKey(e.target.value)}
              />
            )}
          </Field>

          <Field label={t('ai.model')}>
            {(aria) => (
              <Input
                {...aria}
                value={model}
                spellCheck={false}
                onChange={(e) => setModel(e.target.value)}
              />
            )}
          </Field>

          {message && (
            <p role={messageError ? 'alert' : 'status'} className={`text-sm ${messageError ? 'text-destructive' : 'text-muted-foreground'}`}>
              {message}
            </p>
          )}

          <div className="flex flex-wrap gap-2">
            <Button size="sm" onClick={() => void save()} disabled={busy || !key.trim()}>
              {t('ai.keySave')}
            </Button>
            <Button size="sm" variant="secondary" onClick={() => void test()} disabled={busy || !configured}>
              {t('ai.keyTest')}
            </Button>
            <Button size="sm" variant="ghost" onClick={() => void remove()} disabled={busy || !configured}>
              {t('ai.keyRemove')}
            </Button>
          </div>
        </div>
      )}
    </Card>
  )
}

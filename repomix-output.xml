import { describe, expect, it } from 'vitest'
import { buildDigest } from './digest'

describe('buildDigest', () => {
  it('monta o payload com metadados e sem segredos', () => {
    const payload = buildDigest(
      {
        date: '2026-10-14',
        tasksOpen: 3,

import { useState, type FormEvent, type ReactNode } from 'react'
import { useI18n } from '../../i18n'
import { parseTags, SUGGESTED_TAGS } from '../../diary/feed'
import type { useDiaryData } from '../../diary/useDiary'
import { Button } from '../../ui/Button'
import { Field, Input } from '../../ui/Input'
import { Modal } from '../../ui/Modal'

const inputClass =
  'h-10 w-full rounded-md border border-input bg-card px-3 text-sm text-foreground'

function Shell({
  title,
  onClose,
  busy,
  error,
  onSubmit,
  children,
}: {
  title: string
  onClose: () => void
  busy: boolean
  error: string | null
  onSubmit: (event: FormEvent) => void
  children: ReactNode
}) {
  const { t } = useI18n()
  return (
    <Modal title={title} onClose={onClose} wide>
      <form onSubmit={onSubmit} className="flex flex-col gap-4" noValidate>
        {children}
        {error && (
          <p role="alert" className="text-sm text-destructive">
            {error}
          </p>
        )}
        <div className="flex justify-end gap-2">
          <Button variant="secondary" onClick={onClose} disabled={busy}>
            {t('common.cancel')}
          </Button>
          <Button type="submit" disabled={busy}>
            {busy ? t('common.loading') : t('common.save')}
          </Button>
        </div>
      </form>
    </Modal>
  )
}

type Member = { user_id: string; display_name: string | null }

function VisibilityOwner({
  visibility,
  ownerId,
  members,
  onVisibility,
  onOwner,
}: {
  visibility: 'shared' | 'personal'
  ownerId: string
  members: Member[]
  onVisibility: (value: 'shared' | 'personal') => void
  onOwner: (value: string) => void
}) {
  const { t } = useI18n()
  return (
    <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">

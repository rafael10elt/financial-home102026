<file path="src/features/agenda/ItemDialog.tsx">
import { useState, type FormEvent } from 'react'
import { useI18n } from '../../i18n'
import { Button } from '../../ui/Button'
import { Field, Input } from '../../ui/Input'
import { Modal } from '../../ui/Modal'
import type { Frequency } from '../../agenda/recurrence'
import type { RecurrenceRuleInput } from '../../data/agenda'
import type { Category, AgendaEvent, AgendaTask, AgendaReminder } from '../../agenda/useAgenda'

export type ItemKind = 'event' | 'task' | 'reminder'

type Member = { user_id: string; display_name: string | null }

function toLocalInput(iso: string | null): string {
  if (!iso) return ''
  const date = new Date(iso)
  if (Number.isNaN(date.getTime())) return ''
  const pad = (n: number) => String(n).padStart(2, '0')
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function fromLocalInput(value: string): string {
  return new Date(value).toISOString()
}

export function ItemDialog({
  kind,
  initial,
  categories,
  members,
  busy,
  serverError,
  onClose,
  onSave,
  onCreateCategory,
}: {
  kind: ItemKind
  initial: AgendaEvent | AgendaTask | AgendaReminder | null
  categories: Category[]
  members: Member[]
  busy: boolean
  serverError: string | null
  onClose: () => void
  onSave: (values: Record<string, unknown>, rule: RecurrenceRuleInput | null) => void
  onCreateCategory: (name: string) => Promise<{ error: string | null; id?: string }>
}) {
  const { t } = useI18n()

  const asEvent = kind === 'event' ? (initial as AgendaEvent | null) : null
  const asTask = kind === 'task' ? (initial as AgendaTask | null) : null
  const asReminder = kind === 'reminder' ? (initial as AgendaReminder | null) : null

  const [title, setTitle] = useState(initial?.title ?? '')
  const [notes, setNotes] = useState(
    asEvent?.description ?? asTask?.notes ?? asReminder?.notes ?? '',
  )
  const [location, setLocation] = useState(asEvent?.location ?? '')
  const [start, setStart] = useState(() =>
    toLocalInput(asEvent?.start_at ?? asTask?.due_at ?? asReminder?.remind_at ?? null),
  )
  const [end, setEnd] = useState(() => toLocalInput(asEvent?.end_at ?? null))
  const [allDay, setAllDay] = useState(asEvent?.all_day ?? false)
  const [priority, setPriority] = useState<'low' | 'medium' | 'high' | 'urgent'>(
    asTask?.priority ?? 'medium',
  )
  const [categoryId, setCategoryId] = useState(initial?.category_id ?? '')
  const [newCategory, setNewCategory] = useState('')
  const [visibility, setVisibility] = useState<'shared' | 'personal'>(
    initial?.visibility ?? 'shared',
  )
  const [ownerId, setOwnerId] = useState(initial?.owner_id ?? '')
  const [frequency, setFrequency] = useState<'none' | Frequency>(
    initial?.recurrence_rule_id ? 'daily' : 'none',
  )
  const [intervalN, setIntervalN] = useState('1')
  const [weekdays, setWeekdays] = useState<number[]>([])
  const [endMode, setEndMode] = useState<'never' | 'date' | 'count'>('never')
  const [endDate, setEndDate] = useState('')
  const [endCount, setEndCount] = useState('10')
  const [formError, setFormError] = useState<string | null>(null)

  const dialogTitle =
    kind === 'event'
      ? initial
        ? t('agenda.editEvent')
        : t('agenda.newEvent')
      : kind === 'task'
        ? initial
          ? t('agenda.editTask')
          : t('agenda.newTask')
        : initial
          ? t('agenda.editReminder')
          : t('agenda.newReminder')

  function toggleWeekday(day: number) {
    setWeekdays((current) =>
      current.includes(day) ? current.filter((d) => d !== day) : [...current, day].sort(),
    )
  }

  async function handleSubmit(event: FormEvent) {
    event.preventDefault()
    setFormError(null)

    if (!title.trim()) {
      setFormError(t('common.required'))
      return
    }

    let finalCategoryId = categoryId || null
    if (newCategory.trim()) {
      const created = await onCreateCategory(newCategory.trim())
      if (created.error || !created.id) {
        setFormError(created.error ?? t('common.required'))
        return
      }
      finalCategoryId = created.id
    }

    const values: Record<string, unknown> = {
      title: title.trim(),
      category_id: finalCategoryId,
      visibility,
      owner_id: ownerId || null,
    }

    if (kind === 'event') {
      if (!start) {
        setFormError(t('common.required'))
        return
      }
      values.description = notes.trim() || null
      values.location = location.trim() || null
      values.start_at = fromLocalInput(start)
      values.end_at = end ? fromLocalInput(end) : null
      values.all_day = allDay
    } else if (kind === 'task') {
      values.notes = notes.trim() || null
      values.due_at = start ? fromLocalInput(start) : null
      values.priority = priority
    } else {
      if (!start) {
        setFormError(t('common.required'))
        return
      }
      values.notes = notes.trim() || null
      values.remind_at = fromLocalInput(start)
    }

    let rule: RecurrenceRuleInput | null = null
    if (frequency !== 'none' && !initial) {
      const startDate = (kind === 'event' ? values.start_at : values.due_at ?? values.remind_at) as
        | string
        | null
      if (!startDate) {
        setFormError(t('common.required'))
        return
      }
      rule = {
        frequency,
        interval_n: Math.max(1, Number.parseInt(intervalN, 10) || 1),
        days_of_week: frequency === 'weekly' && weekdays.length > 0 ? weekdays : null,
        month_day: null,
        start_date: (startDate as string).slice(0, 10),
        end_date: endMode === 'date' && endDate ? endDate : null,
        occurrence_count:
          endMode === 'count' ? Math.max(1, Number.parseInt(endCount, 10) || 1) : null,
        timezone: 'Europe/Dublin',
      }
    }

    onSave(values, rule)
  }

  const inputClass =
    'h-10 w-full rounded-md border border-input bg-card px-3 text-sm text-foreground'

  return (
    <Modal title={dialogTitle} onClose={onClose} wide>
      <form onSubmit={handleSubmit} className="flex flex-col gap-4" noValidate>
        <Field label={t('agenda.titleField')} error={!title.trim() ? t('common.required') : null}>
          {(aria) => (
            <Input {...aria} value={title} maxLength={120} onChange={(e) => setTitle(e.target.value)} />
          )}
        </Field>

        {kind === 'event' && (
          <>
            <Field label={t('agenda.description')}>
              {(aria) => (
                <textarea
                  {...aria}
                  value={notes}
                  rows={2}
                  maxLength={2000}
                  onChange={(e) => setNotes(e.target.value)}
                  className={`${inputClass} h-auto py-2`}
                />
              )}
            </Field>
            <Field label={t('agenda.location')}>
              {(aria) => (
                <Input
                  {...aria}
                  value={location}
                  maxLength={200}
                  onChange={(e) => setLocation(e.target.value)}
                />
              )}
            </Field>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <Field label={t('agenda.start')}>
                {(aria) => (
                  <Input
                    {...aria}
                    type="datetime-local"
                    value={start}
                    onChange={(e) => setStart(e.target.value)}
                  />
                )}
              </Field>
              <Field label={t('agenda.end')}>
                {(aria) => (
                  <Input
                    {...aria}
                    type="datetime-local"
                    value={end}
                    onChange={(e) => setEnd(e.target.value)}
                  />
                )}
              </Field>
            </div>
            <label className="flex items-center gap-2 text-sm">
              <input
                type="checkbox"
                checked={allDay}
                onChange={(e) => setAllDay(e.target.checked)}
              />
              {t('agenda.allDay')}
            </label>
          </>
        )}

        {kind === 'task' && (
          <>
            <Field label={t('agenda.notes')}>
              {(aria) => (
                <textarea
                  {...aria}
                  value={notes}
                  rows={2}
                  maxLength={2000}
                  onChange={(e) => setNotes(e.target.value)}
                  className={`${inputClass} h-auto py-2`}
                />
              )}
            </Field>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <Field label={t('agenda.dueAt')}>
                {(aria) => (
                  <Input
                    {...aria}
                    type="datetime-local"
                    value={start}
                    onChange={(e) => setStart(e.target.value)}
                  />
                )}
              </Field>
              <Field label={t('agenda.priority')}>
                {(aria) => (
                  <select
                    {...aria}
                    value={priority}
                    onChange={(e) =>
                      setPriority(e.target.value as 'low' | 'medium' | 'high' | 'urgent')
                    }
                    className={inputClass}
                  >
                    {(['low', 'medium', 'high', 'urgent'] as const).map((p) => (
                      <option key={p} value={p}>
                        {t(`agenda.priority.${p}`)}
                      </option>
                    ))}
                  </select>
                )}
              </Field>
            </div>
          </>
        )}

        {kind === 'reminder' && (
          <>
            <Field label={t('agenda.notes')}>
              {(aria) => (
                <textarea
                  {...aria}
                  value={notes}
                  rows={2}
                  maxLength={2000}
                  onChange={(e) => setNotes(e.target.value)}
                  className={`${inputClass} h-auto py-2`}
                />
              )}
            </Field>
            <Field label={t('agenda.remindAt')}>
              {(aria) => (
                <Input
                  {...aria}
                  type="datetime-local"
                  value={start}
                  onChange={(e) => setStart(e.target.value)}
                />
              )}
            </Field>
          </>
        )}

        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Field label={t('agenda.category')}>
            {(aria) => (
              <select
                {...aria}
                value={categoryId}
                onChange={(e) => setCategoryId(e.target.value)}
                className={inputClass}
              >
                <option value="">—</option>
                {categories.map((category) => (
                  <option key={category.id} value={category.id}>
                    {category.name}
                  </option>
                ))}
              </select>
            )}
          </Field>
          <Field label={`${t('agenda.category')} (nova)`}>
            {(aria) => (
              <Input
                {...aria}
                value={newCategory}
                maxLength={40}
                placeholder="—"
                onChange={(e) => setNewCategory(e.target.value)}
              />
            )}
          </Field>
        </div>

        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Field label={t('agenda.visibility')}>
            {(aria) => (
              <select
                {...aria}
                value={visibility}
                onChange={(e) => setVisibility(e.target.value as 'shared' | 'personal')}
                className={inputClass}
              >
                <option value="shared">{t('agenda.visibility.shared')}</option>
                <option value="personal">{t('agenda.visibility.personal')}</option>
              </select>
            )}
          </Field>
          <Field label={t('agenda.owner')}>
            {(aria) => (
              <select
                {...aria}
                value={ownerId}
                onChange={(e) => setOwnerId(e.target.value)}
                className={inputClass}
              >
                <option value="">{t('agenda.owner.unassigned')}</option>
                {members.map((member) => (
                  <option key={member.user_id} value={member.user_id}>
                    {member.display_name ?? member.user_id.slice(0, 8)}
                  </option>
                ))}
              </select>
            )}
          </Field>
        </div>

        {!initial && (
          <fieldset className="flex flex-col gap-2 rounded-md border border-border p-3">
            <legend className="px-1 text-sm font-medium">{t('agenda.recurrence')}</legend>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label className="flex flex-col gap-1.5 text-sm">
                {t('agenda.recurrence')}
                <select
                  value={frequency}
                  onChange={(e) => setFrequency(e.target.value as 'none' | Frequency)}
                  className={inputClass}
                >
                  <option value="none">{t('agenda.recurrence.none')}</option>
                  <option value="daily">{t('agenda.recurrence.daily')}</option>
                  <option value="weekly">{t('agenda.recurrence.weekly')}</option>
                  <option value="monthly">{t('agenda.recurrence.monthly')}</option>
                  <option value="yearly">{t('agenda.recurrence.yearly')}</option>
                </select>
              </label>
              {frequency !== 'none' && (
                <label className="flex flex-col gap-1.5 text-sm">
                  {t('agenda.recurrence.intervalUnit')}
                  <Input
                    type="number"
                    min={1}
                    max={365}
                    value={intervalN}
                    onChange={(e) => setIntervalN(e.target.value)}
                  />
                </label>
              )}
            </div>

            {frequency === 'weekly' && (
              <div className="flex flex-wrap gap-1.5" role="group" aria-label={t('agenda.recurrence.weekdays')}>
                {[0, 1, 2, 3, 4, 5, 6].map((day) => (
                  <button
                    key={day}
                    type="button"
                    aria-pressed={weekdays.includes(day)}
                    onClick={() => toggleWeekday(day)}
                    className={
                      weekdays.includes(day)
                        ? 'rounded-md border border-primary bg-accent px-2.5 py-1 text-xs font-medium'
                        : 'rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground'
                    }
                  >
                    {t(`agenda.weekday.${day}` as 'agenda.weekday.0')}
                  </button>
                ))}
              </div>
            )}

            {frequency !== 'none' && (
              <div className="flex flex-wrap items-center gap-2 text-sm">
                <span>{t('agenda.recurrence.end')}:</span>
                {(['never', 'date', 'count'] as const).map((mode) => (
                  <button
                    key={mode}
                    type="button"
                    aria-pressed={endMode === mode}
                    onClick={() => setEndMode(mode)}
                    className={
                      endMode === mode
                        ? 'rounded-md border border-primary bg-accent px-2.5 py-1 text-xs font-medium'
                        : 'rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground'
                    }
                  >
                    {mode === 'never'
                      ? t('agenda.recurrence.endNever')
                      : mode === 'date'
                        ? t('agenda.recurrence.endDate')
                        : t('agenda.recurrence.endCount')}
                  </button>
                ))}
                {endMode === 'date' && (
                  <Input
                    type="date"
                    aria-label={t('agenda.recurrence.endDate')}
                    value={endDate}
                    onChange={(e) => setEndDate(e.target.value)}
                    className="w-auto"
                  />
                )}
                {endMode === 'count' && (
                  <Input
                    type="number"
                    aria-label={t('agenda.recurrence.endCount')}
                    min={1}
                    value={endCount}
                    onChange={(e) => setEndCount(e.target.value)}
                    className="w-24"
                  />
                )}
              </div>
            )}
          </fieldset>
        )}

        {(formError || serverError) && (
          <p role="alert" className="text-sm text-destructive">
            {formError ?? serverError}
          </p>
        )}

        <div className="flex justify-end gap-2">
          <Button variant="secondary" onClick={onClose} disabled={busy}>
            {t('common.cancel')}
          </Button>
          <Button type="submit" disabled={busy}>
            {busy ? t('common.loading') : t('common.save')}
          </Button>
        </div>
      </form>
    </Modal>
  )
}
</file>

<file path="src/features/assistant/AssistantPage.tsx">
import { useEffect, useRef, useState } from 'react'
import { useI18n } from '../../i18n'
import { useAuth } from '../../auth/context'
import { useAgendaData } from '../../agenda/useAgenda'
import { useFinanceData } from '../../finance/useFinance'
import { useDiaryData } from '../../diary/useDiary'
import { buildDigest } from '../../assistant/digest'
import { useAssistantData } from '../../assistant/useAssistant'
import { useVoice } from '../../assistant/useVoice'
import { Button } from '../../ui/Button'
import { Card, CardDescription, CardTitle } from '../../ui/Card'
import { Field, Input } from '../../ui/Input'

type Tab = 'chat' | 'memory' | 'automations'

export function AssistantPage() {
  const { t } = useI18n()
  const assistant = useAssistantData()
  const [tab, setTab] = useState<Tab>('chat')
  const [input, setInput] = useState('')
  const [chatError, setChatError] = useState<string | null>(null)
  const [memoryDraft, setMemoryDraft] = useState('')
  const [editingMemory, setEditingMemory] = useState<string | null>(null)
  const [editingContent, setEditingContent] = useState('')
  const [webhookName, setWebhookName] = useState('')
  const [webhookUrl, setWebhookUrl] = useState('')
  const [webhookMsg, setWebhookMsg] = useState<string | null>(null)
  const [copied, setCopied] = useState(false)
  const bottomRef = useRef<HTMLDivElement>(null)

  const voice = useVoice((text) => setInput((current) => (current ? `${current} ${text}` : text)))

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: 'smooth', block: 'end' })
  }, [assistant.messages.length, tab])

  async function handleSend() {
    const text = voice.transcript.trim() || input.trim()
    if (!text || assistant.sending) return
    voice.stopListening()
    setInput('')
    setChatError(null)
    const result = await assistant.sendMessage(text)
    if (!result.ok) {
      const kind = assistant.errorKind(result.code)
      if (kind === 'no-key') setChatError(t('ai.noKey'))
      else if (kind === 'invalid') setChatError(t('ai.error.invalid'))
      else if (kind === 'quota') setChatError(t('ai.error.quota'))
      else if (kind === 'model') setChatError(t('ai.error.model'))
      else if (kind === 'session') setChatError(t('ai.error.session'))
      else if (result.code === 'FUNCTIONS_UNCONFIGURED' || result.code === 'CONVERSATION_FAILED') {
        setChatError(t('ai.backendMissing'))
      } else setChatError(t('ai.error.unknown'))
    }
  }

  const keyMissing = assistant.keyStatus.checked && !assistant.keyStatus.configured

  return (
    <div className="flex flex-col gap-4">
      <div className="flex flex-wrap items-center gap-2">
        <h1 className="text-xl font-semibold">{t('ai.title')}</h1>
        <div className="ml-auto">
          <Button size="sm" variant="secondary" onClick={() => void assistant.newConversation()}>
            {t('ai.newChat')}
          </Button>
        </div>
      </div>

      <div className="flex flex-wrap gap-2" role="tablist" aria-label={t('ai.title')}>
        {(['chat', 'memory', 'automations'] as Tab[]).map((value) => (
          <button
            key={value}
            type="button"
            role="tab"
            aria-selected={tab === value}
            onClick={() => setTab(value)}
            className={
              tab === value
                ? 'rounded-md border border-primary bg-accent px-3 py-1.5 text-sm font-medium'
                : 'rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground hover:bg-muted'
            }
          >
            {t(`ai.tabs.${value}`)}
          </button>
        ))}
      </div>

      {keyMissing && (
        <Card>
          <p className="text-sm text-muted-foreground" role="status">
            {assistant.isOwner ? t('ai.noKeyOwner') : t('ai.noKeyMember')}
          </p>
        </Card>
      )}

      {tab === 'chat' && (
        <div className="flex flex-col gap-3">
          {assistant.conversations.length > 1 && (
            <div className="flex flex-wrap gap-1.5">
              {assistant.conversations.slice(0, 10).map((conversation) => (
                <button
                  key={conversation.id}
                  type="button"
                  onClick={() => assistant.setActiveId(conversation.id)}
                  aria-pressed={assistant.activeId === conversation.id}
                  className={
                    assistant.activeId === conversation.id
                      ? 'rounded-md border border-primary bg-accent px-2.5 py-1 text-xs font-medium'
                      : 'rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground'
                  }
                >
                  {(conversation.title || 'Conversa').slice(0, 24)}
                </button>
              ))}
            </div>
          )}

          <Card>
            <div className="flex max-h-[50dvh] flex-col gap-3 overflow-y-auto" aria-live="polite">
              {assistant.messages.length === 0 && (
                <p className="text-sm text-muted-foreground">{t('ai.inputPlaceholder')}</p>
              )}
              {assistant.messages.map((message) => (
                <div key={message.id} className="flex flex-col gap-1.5">
                  <div
                    className={
                      message.role === 'user'
                        ? 'self-end rounded-lg bg-primary px-3 py-2 text-sm text-primary-foreground'
                        : 'self-start rounded-lg border border-border bg-muted px-3 py-2 text-sm'
                    }
                  >
                    <p className="whitespace-pre-wrap">{message.content}</p>
                    {message.role === 'assistant' && (
                      <button
                        type="button"
                        className="mt-1 text-xs underline opacity-70 hover:opacity-100"
                        onClick={() => voice.speak(message.content)}
                        disabled={!voice.supportedSynthesis || voice.speaking}
                      >
                        {voice.speaking ? t('ai.stop') : t('ai.speak')}
                      </button>
                    )}
                  </div>
                  {message.pending?.map((pending) => (
                    <div key={pending.action_id} className="self-start rounded-lg border border-primary/50 bg-card p-3 text-sm">
                      <p className="font-medium">{t('ai.confirmTitle')}</p>
                      <p className="text-xs text-muted-foreground">{t('ai.confirmBody')}</p>
                      <p className="mt-1 rounded bg-muted px-2 py-1 font-mono text-xs">{pending.preview}</p>
                      <p className="mt-1 text-xs text-muted-foreground">{pending.tool}</p>
                      <div className="mt-2 flex gap-2">
                        <Button
                          size="sm"
                          disabled={assistant.sending}
                          onClick={() => void assistant.confirmAction(pending.action_id).then(() => assistant.reload())}
                        >
                          {t('ai.confirmYes')}
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
              <div ref={bottomRef} />
            </div>

            {chatError && (
              <p role="alert" className="mt-2 text-sm text-destructive">
                {chatError}
              </p>
            )}

            <div className="mt-3 flex items-end gap-2">
              <div className="flex-1">
                <label htmlFor="ai-input" className="sr-only">
                  {t('ai.inputPlaceholder')}
                </label>
                <textarea
                  id="ai-input"
                  value={voice.transcript || input}
                  rows={2}
                  placeholder={t('ai.inputPlaceholder')}
                  onChange={(e) => setInput(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                      e.preventDefault()
                      void handleSend()
                    }
                  }}
                  className="h-auto w-full rounded-md border border-input bg-card px-3 py-2 text-sm"
                />
              </div>
              <div className="flex flex-col gap-1.5">
                {voice.supportedRecognition ? (
                  <Button
                    size="sm"
                    variant={voice.listening ? 'destructive' : 'secondary'}
                    onClick={() => (voice.listening ? voice.stopListening() : voice.startListening())}
                    aria-pressed={voice.listening}
                    aria-label={t('ai.mic')}
                  >
                    {voice.listening ? '●' : '🎤'}
                  </Button>
                ) : null}
                <Button size="sm" onClick={() => void handleSend()} disabled={assistant.sending}>
                  {assistant.sending ? t('common.loading') : t('ai.send')}
                </Button>
              </div>
            </div>
            {voice.listening && (
              <p className="mt-1 text-xs text-destructive" role="status">
                {t('ai.listening')}
              </p>
            )}
            {!voice.supportedRecognition && !voice.supportedSynthesis && (
              <p className="mt-1 text-xs text-muted-foreground">{t('ai.voiceUnsupported')}</p>
            )}
          </Card>
        </div>
      )}

      {tab === 'memory' && (
        <MemoryTab
          memoryDraft={memoryDraft}
          setMemoryDraft={setMemoryDraft}
          editingMemory={editingMemory}
          setEditingMemory={setEditingMemory}
          editingContent={editingContent}
          setEditingContent={setEditingContent}
        />
      )}

      {tab === 'automations' && (
        <AutomationsTab
          webhookName={webhookName}
          setWebhookName={setWebhookName}
          webhookUrl={webhookUrl}
          setWebhookUrl={setWebhookUrl}
          webhookMsg={webhookMsg}
          setWebhookMsg={setWebhookMsg}
          copied={copied}
          setCopied={setCopied}
        />
      )}
    </div>
  )
}

function MemoryTab({
  memoryDraft,
  setMemoryDraft,
  editingMemory,
  setEditingMemory,
  editingContent,
  setEditingContent,
}: {
  memoryDraft: string
  setMemoryDraft: (value: string) => void
  editingMemory: string | null
  setEditingMemory: (value: string | null) => void
  editingContent: string
  setEditingContent: (value: string) => void
}) {
  const { t } = useI18n()
  const assistant = useAssistantData()

  return (
    <div className="flex flex-col gap-3">
      <Card>
        <CardTitle className="mb-2">{t('ai.memoryTitle')}</CardTitle>
        {assistant.memories.length === 0 ? (
          <p className="text-sm text-muted-foreground">{t('ai.memoryEmpty')}</p>
        ) : (
          <ul className="flex flex-col divide-y divide-[var(--border)]">
            {assistant.memories.map((memory) => (
              <li key={memory.id} className={`flex items-start justify-between gap-2 py-2 text-sm ${memory.active ? '' : 'opacity-50'}`}>
                <div className="flex flex-col gap-1">
                  {editingMemory === memory.id ? (
                    <Input
                      value={editingContent}
                      maxLength={1000}
                      onChange={(e) => setEditingContent(e.target.value)}
                      aria-label={t('ai.memoryEdit')}
                    />
                  ) : (
                    <span>{memory.content}</span>
                  )}
                  <span className="text-xs text-muted-foreground">
                    {memory.user_id ? t('fin.unassigned') : t('agenda.visibility.shared')}
                    {!memory.active ? ` · ${t('ai.memoryDisable')}` : ''}
                  </span>
                </div>
                <div className="flex shrink-0 gap-1">
                  {editingMemory === memory.id ? (
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() =>
                        void assistant.updateMemory(memory.id, { content: editingContent.slice(0, 1000) }).then(() => {
                          setEditingMemory(null)
                          assistant.reload()
                        })
                      }
                    >
                      {t('common.save')}
                    </Button>
                  ) : (
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() => {
                        setEditingMemory(memory.id)
                        setEditingContent(memory.content)
                      }}
                    >
                      {t('ai.memoryEdit')}
                    </Button>
                  )}
                  <Button
                    size="sm"
                    variant="ghost"
                    onClick={() =>
                      void assistant.updateMemory(memory.id, { active: !memory.active }).then(() => assistant.reload())
                    }
                  >
                    {memory.active ? t('ai.memoryDisable') : t('ai.memoryEnable')}
                  </Button>
                  <Button
                    size="sm"
                    variant="ghost"
                    onClick={() => void assistant.deleteMemory(memory.id).then(() => assistant.reload())}
                  >
                    {t('ai.memoryDelete')}
                  </Button>
                </div>
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card>
        <div className="flex gap-2">
          <Input
            value={memoryDraft}
            maxLength={1000}
            placeholder={t('ai.memoryPlaceholder')}
            onChange={(e) => setMemoryDraft(e.target.value)}
            aria-label={t('ai.memoryAdd')}
          />
          <Button
            size="sm"
            onClick={() =>
              memoryDraft.trim()
                ? void assistant.saveMemory(memoryDraft.trim()).then(() => {
                    setMemoryDraft('')
                    assistant.reload()
                  })
                : undefined
            }
          >
            {t('ai.memoryAdd')}
          </Button>
        </div>
      </Card>
    </div>
  )
}

function AutomationsTab({
  webhookName,
  setWebhookName,
  webhookUrl,
  setWebhookUrl,
  webhookMsg,
  setWebhookMsg,
  copied,
  setCopied,
}: {
  webhookName: string
  setWebhookName: (value: string) => void
  webhookUrl: string
  setWebhookUrl: (value: string) => void
  webhookMsg: string | null
  setWebhookMsg: (value: string | null) => void
  copied: boolean
  setCopied: (value: boolean) => void
}) {
  const { t } = useI18n()
  const assistant = useAssistantData()
  const agenda = useAgendaData()
  const finance = useFinanceData()
  const diary = useDiaryData()
  const { user } = useAuth()

  const digest = buildDigest({
    date: new Date().toISOString().slice(0, 10),
    tasksOpen: agenda.tasks.filter((task) => task.status === 'open').length,
    tasksOverdue: agenda.tasks
      .filter((task) => task.status === 'open' && task.due_at && task.due_at < new Date().toISOString())
      .slice(0, 10)
      .map((task) => ({ title: task.title, dueAt: task.due_at })),
    eventsToday: [],
    remindersToday: [],
    finance: {
      incomeMinor: 0,
      expenseMinor: 0,
      pending: finance.transactions.filter((tx) => tx.status === 'pendente' || tx.status === 'previsto').length,
      overdue: 0,
      currency: 'EUR',
    },
    moods: diary.userMoods.slice(0, 5).map((entry) => ({
      user: entry.user_id === user?.id ? 'você' : entry.user_id.slice(0, 8),
      mood: entry.mood?.name ?? '?',
    })),
    unreadNotifications: agenda.notifications.filter((n) => !n.read_at).length,
  })
  const digestJson = JSON.stringify(digest, null, 2)

  async function sendToWebhook(url: string) {
    setWebhookMsg(null)
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: digestJson,
      })
      if (!response.ok) {
        setWebhookMsg(t('ai.webhookFailed', { message: `HTTP ${response.status}` }))
        return
      }
      setWebhookMsg(t('ai.webhookSent', { status: response.status }))
    } catch (error) {
      setWebhookMsg(
        t('ai.webhookFailed', { message: error instanceof Error ? error.message : String(error) }),
      )
    }
  }

  return (
    <div className="flex flex-col gap-3">
      <Card>
        <CardTitle className="mb-1">{t('ai.n8nTitle')}</CardTitle>
        <CardDescription className="mb-1">{t('ai.n8nHint')}</CardDescription>
        <CardDescription>{t('ai.digestNote')}</CardDescription>
      </Card>

      <Card>
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <Field label={t('ai.webhookName')}>
            {(aria) => <Input {...aria} value={webhookName} maxLength={60} onChange={(e) => setWebhookName(e.target.value)} />}
          </Field>
          <Field label={t('ai.webhookUrl')}>
            {(aria) => (
              <Input
                {...aria}
                value={webhookUrl}
                inputMode="url"
                placeholder="https://n8n.exemplo.com/webhook/…"
                onChange={(e) => setWebhookUrl(e.target.value)}
              />
            )}
          </Field>
        </div>
        <div className="mt-3 flex flex-wrap gap-2">
          <Button
            size="sm"
            disabled={!webhookName.trim() || !webhookUrl.startsWith('https://') || !assistant.isOwner}
            onClick={() =>
              void assistant
                .saveWebhook({ name: webhookName.trim(), url: webhookUrl.trim(), events: ['digest'], active: true }, null)
                .then(() => {
                  setWebhookName('')
                  setWebhookUrl('')
                  assistant.reload()
                })
            }
          >
            {t('ai.webhookSave')}
          </Button>
          <Button
            size="sm"
            variant="secondary"
            onClick={() => {
              void navigator.clipboard.writeText(digestJson).then(() => {
                setCopied(true)
                setTimeout(() => setCopied(false), 2000)
              })
            }}
          >
            {copied ? t('ai.webhookCopied') : t('ai.webhookCopy')}
          </Button>
        </div>
        {!assistant.isOwner && (
          <p className="mt-2 text-xs text-muted-foreground">{t('ai.keyOwnerOnly')}</p>
        )}
      </Card>

      {assistant.webhooks.length === 0 ? (
        <Card>
          <p className="text-sm text-muted-foreground">{t('ai.webhookEmpty')}</p>
        </Card>
      ) : (
        assistant.webhooks.map((hook) => (
          <Card key={hook.id}>
            <div className="flex items-center justify-between gap-2">
              <div className="flex flex-col">
                <span className="text-sm font-medium">{hook.name}</span>
                <span className="break-all text-xs text-muted-foreground">{hook.url}</span>
              </div>
              <div className="flex shrink-0 gap-1">
                <Button size="sm" variant="secondary" onClick={() => void sendToWebhook(hook.url)}>
                  {t('ai.webhookSend')}
                </Button>
                <Button size="sm" variant="ghost" onClick={() => void assistant.deleteWebhook(hook.id).then(() => assistant.reload())}>
                  {t('agenda.delete')}
                </Button>
              </div>
            </div>
          </Card>
        ))
      )}

      {webhookMsg && (
        <p role="status" className="text-sm text-muted-foreground">
          {webhookMsg}
        </p>
      )}

      <Card>
        <CardTitle className="mb-2">digest.json</CardTitle>
        <pre className="max-h-64 overflow-auto rounded-md bg-muted p-3 font-mono text-[11px]">{digestJson}</pre>
      </Card>
    </div>
  )
}
</file>

<file path="src/features/auth/LoginPage.tsx">
import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { useAuth } from '../../auth/context'
import { useI18n } from '../../i18n'
import { Card, CardDescription, CardTitle } from '../../ui/Card'

export function LoginPage() {
  const { t } = useI18n()
  const { selectProfile, status } = useAuth()
  const navigate = useNavigate()
  const profiles = (import.meta.env.VITE_PROFILES || 'Jéssica,Rafael')
    .split(',').map((name: string) => name.trim()).filter(Boolean)
  const [error, setError] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)
  async function chooseProfile(name: string) {
    setError(null)
    setBusy(true)
    try {
      const result = await selectProfile(name)
      if (result.error) return setError(result.error)
      navigate('/', { replace: true })
    } finally {
      setBusy(false)
    }
  }

  if (status === 'loading') {
    return (
      <div className="flex min-h-dvh items-center justify-center bg-background">
        <p className="text-sm text-muted-foreground">{t('auth.loading')}</p>
      </div>
    )
  }

  return (
    <div className="flex min-h-dvh items-center justify-center bg-background px-4">
      <Card className="w-full max-w-lg">

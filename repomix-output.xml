      fetchedAt: '2026-10-14T10:00:00Z',
      manual: true,
    })
    expect(converted.convertedMinor).toBe(1650)
    expect(converted.convertedCurrency).toBe('EUR')
    expect(converted.isEstimate).toBe(true)

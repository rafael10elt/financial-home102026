# ATENÇÃO: este arquivo é versionado no Git — mantenha SOMENTE placeholders
# aqui. Os valores reais vivem no `.env` local (não versionado).
VITE_SUPABASE_URL=https://wvyllpbqtahxrqsjjzgp.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_SUA_CHAVE_ANON_PUBLICA_AQUI
# GROQ_API_KEY= (segredo configurado nas Edge Functions; nunca no frontend)

# Perfis mostrados na tela de entrada, separados por vírgula.

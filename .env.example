# Financial Home 102026 — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o arquivo `.env`.

# Supabase (projeto) — obrigatório.
# Encontre em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_KEY_PUBLICA

# --- Somente em contexto server-side (Netlify Functions / Edge Functions) ---
# NUNCA use prefixo VITE_ para segredos: eles seriam embutidos no bundle.
# GROQ_API_KEY=
# FH_GROQ_ENC_KEY=            # chave de criptografia da chave Groq (32 bytes em hex)
# EXCHANGE_API_KEY=
